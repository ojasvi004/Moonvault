# ---------------------------------------------------------------- public (browser)
# Set to true to run the whole app with mock services (no keys needed).
NEXT_PUBLIC_MOCK_SERVICES=false
# thirdweb client ID (publishable, free at https://thirdweb.com/dashboard). Enable Email login for in-app wallets.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
# Auto-lock after N minutes of inactivity.
NEXT_PUBLIC_AUTO_LOCK_MINUTES=5

# ---------------------------------------------------------------- server only (never NEXT_PUBLIC_)
# 0G Private Computer API key (sk-...) from https://pc.0g.ai -> Dashboard -> API Keys
ZG_API_KEY=
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_CHAT_MODEL=qwen3.7-flash
ZG_STT_MODEL=openai/whisper-large-v3
ZG_AUDIO_CHAT_MODEL=qwen3.5-omni-flash
# Optional: "verified" or "private" (TEE + E2EE + zero data retention) routing
ZG_TRUST_MODE=

# Arkiv access key (free) from https://hub.arkiv.network/access-keys. Empty = rate-limited public endpoint.
ARKIV_ACCESS_KEY=

# Relay key: funded for free at https://hub.arkiv.network/faucet (tGLM, Arkiv testnet)
# and https://faucet.0g.ai (0G Galileo testnet). Used by /api/fund and /api/storage/upload.
RELAY_PRIVATE_KEY=
# Optional separate key for 0G Storage uploads (defaults to RELAY_PRIVATE_KEY)
ZG_STORAGE_PRIVATE_KEY=
ZG_EVM_RPC=https://evmrpc-testnet.0g.ai
ZG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
FUND_AMOUNT=0.002
FUND_MIN_BALANCE=0.0005
